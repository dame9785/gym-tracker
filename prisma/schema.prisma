generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                  Int                  @id @default(autoincrement())
  firstName           String               @db.VarChar(50)
  lastName            String               @db.VarChar(50)
  username            String               @unique @db.VarChar(50)
  email               String               @unique @db.VarChar(100)
  phoneNumber         String               @unique @db.VarChar(20)
  passwordHash        String
  passwordResetTokens PasswordResetToken[]

  tokenVersion Int @default(0)

  bodyWeight Decimal @db.Decimal(5, 2)
  goalWeight Decimal @db.Decimal(5, 2)
  height     Decimal @db.Decimal(5, 2)

  gender    Gender
  birthDate DateTime @db.Date
  goalDate  DateTime @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goalType GoalType
  goal     Goal?

  workout          Workout[]
  workoutSchedules WorkoutSchedule[]
  workoutSessions  WorkoutSession[]
  weightLogs       WeightLog[]

  exercises Exercise[]

  meals       Meal[]
  customFoods CustomFood[]
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @db.VarChar(64)
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model WeightLog {
  id       Int      @id @default(autoincrement())
  userId   Int
  weight   Decimal  @db.Decimal(5, 2)
  note     String?  @db.VarChar(255)
  loggedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

enum GoalType {
  WEIGHT_LOSS
  MUSCLE_GAIN
  MAINTENANCE
}

enum ProgressionMetric {
  WEIGHT
  REPS
  TIME
}

model Goal {
  id     Int @id @default(autoincrement())
  userId Int @unique

  user User @relation(fields: [userId], references: [id])

  calories Int?
  protein  Int?
  carbs    Int?
  fat      Int?
}

enum MuscleRole {
  PRIMARY
  SECONDARY
}

model MuscleGroup {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  exercises ExerciseMuscle[]
}

model ExerciseMuscle {
  exerciseId    Int
  muscleGroupId Int
  role          MuscleRole

  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroup MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscleGroupId])
  @@index([muscleGroupId, role])
}

model Exercise {
  id            Int       @id @default(autoincrement())
  name          String
  slug          String?   @unique @db.VarChar(191)
  equipment     String?   @db.VarChar(50)
  imagePath     String?
  description   String    @db.Text
  instructions  String    @db.Text
  techniqueTips String?   @db.Text
  archivedAt    DateTime?

  userId Int
  user   User @relation(fields: [userId], references: [id])

  muscles  ExerciseMuscle[]
  workouts WorkoutExercise[]

  @@index([userId, archivedAt])
}

model Workout {
  id               Int       @id @default(autoincrement())
  userId           Int
  name             String    @db.VarChar(100)
  description      String?   @db.VarChar(500)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  estimatedMinutes Int?
  archivedAt       DateTime?

  user      User              @relation(fields: [userId], references: [id])
  exercises WorkoutExercise[]
  schedules WorkoutSchedule[]
  sessions  WorkoutSession[]

  @@index([userId])
  @@index([userId, archivedAt])
}

model WorkoutExercise {
  id         Int       @id @default(autoincrement())
  workoutId  Int
  exerciseId Int
  sets       Int
  reps       Int?
  weight     Float?
  order      Int
  seconds    Int?
  note       String?   @db.VarChar(500)
  archivedAt DateTime?

  workout  Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  sessionExercises WorkoutSessionExercise[]

  @@index([workoutId])
  @@index([exerciseId])
  @@index([workoutId, archivedAt])
}

model WorkoutSchedule {
  id        Int      @id @default(autoincrement())
  userId    Int
  workoutId Int
  date      DateTime
  createdAt DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id])
  workout  Workout          @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  sessions WorkoutSession[]

  @@index([userId])
  @@index([workoutId])
}

model WorkoutSession {
  id                 Int                  @id @default(autoincrement())
  userId             Int
  workoutId          Int
  workoutScheduleId  Int?
  workoutName        String               @db.VarChar(100)
  workoutDescription String?              @db.VarChar(500)
  activeKey          String?              @unique @db.VarChar(191)
  startedAt          DateTime             @default(now())
  finishedAt         DateTime?
  status             WorkoutSessionStatus @default(ACTIVE)

  user            User                     @relation(fields: [userId], references: [id])
  workout         Workout                  @relation(fields: [workoutId], references: [id], onDelete: Restrict)
  workoutSchedule WorkoutSchedule?         @relation(fields: [workoutScheduleId], references: [id], onDelete: SetNull)
  exercises       WorkoutSessionExercise[]

  @@index([userId])
  @@index([workoutId])
  @@index([workoutScheduleId])
}

model WorkoutSessionExercise {
  id                    Int     @id @default(autoincrement())
  workoutSessionId      Int
  workoutExerciseId     Int
  exerciseName          String  @db.VarChar(191)
  exerciseImagePath     String? @db.Text
  exerciseEquipment     String? @db.VarChar(50)
  exerciseDescription   String  @db.Text
  exerciseInstructions  String  @db.Text
  exerciseTechniqueTips String? @db.Text
  primaryMuscle         String  @db.VarChar(191)
  secondaryMuscles      String  @db.Text
  order                 Int

  workoutSession  WorkoutSession  @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Restrict)

  sets WorkoutSessionSet[]

  @@index([workoutSessionId])
  @@index([workoutExerciseId])
}

model WorkoutSessionSet {
  id                       Int       @id @default(autoincrement())
  workoutSessionExerciseId Int
  setNumber                Int
  targetReps               Int
  targetSeconds            Int?
  targetWeight             Float?
  actualReps               Int?
  actualSeconds            Int?
  actualWeight             Float?
  completed                Boolean   @default(false)
  completedAt              DateTime?

  workoutSessionExercise WorkoutSessionExercise @relation(fields: [workoutSessionExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutSessionExerciseId])
}

model Product {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(191)
  brand    String? @db.VarChar(100)
  barcode  String? @unique @db.VarChar(50)
  category String? @db.VarChar(100)
  imageUrl String? @db.Text

  calories Decimal @db.Decimal(8, 2)
  protein  Decimal @db.Decimal(8, 2)
  carbs    Decimal @db.Decimal(8, 2)
  fat      Decimal @db.Decimal(8, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mealItems MealItem[]

  @@index([name])
  @@index([category])
}

model CustomFood {
  id     Int     @id @default(autoincrement())
  userId Int
  name   String  @db.VarChar(191)
  brand  String? @db.VarChar(100)

  calories Decimal @db.Decimal(8, 2)
  protein  Decimal @db.Decimal(8, 2)
  carbs    Decimal @db.Decimal(8, 2)
  fat      Decimal @db.Decimal(8, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealItems MealItem[]

  @@index([userId, name])
}

model Meal {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String?  @db.VarChar(100)
  type      MealType
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MealItem[]

  @@index([userId, date])
}

model MealItem {
  id           Int  @id @default(autoincrement())
  mealId       Int
  productId    Int?
  customFoodId Int?

  quantity Decimal @db.Decimal(8, 2)

  // Näringsvärden för den registrerade mängden
  nameSnapshot     String  @db.VarChar(191)
  caloriesSnapshot Decimal @db.Decimal(10, 2)
  proteinSnapshot  Decimal @db.Decimal(10, 2)
  carbsSnapshot    Decimal @db.Decimal(10, 2)
  fatSnapshot      Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  meal       Meal        @relation(fields: [mealId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id], onDelete: Restrict)
  customFood CustomFood? @relation(fields: [customFoodId], references: [id], onDelete: Restrict)

  @@index([mealId])
  @@index([productId])
  @@index([customFoodId])
}

// ==========================================
// Enums
// ==========================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum WorkoutSessionStatus {
  ACTIVE
  COMPLETED
  NOTCOMPLETED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  OTHER
}
